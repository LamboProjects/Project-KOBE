# Copy to config/.env and fill in.

# --- OpenClaw (Brain) ---
OPENCLAW_API_URL=https://your-vps-hostname
OPENCLAW_API_KEY=
OPENCLAW_AGENT=main
OPENCLAW_TIMEOUT_S=30

# --- ElevenLabs (TTS primary) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- OpenAI (TTS fallback, future tooling) ---
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# --- Whisper (local STT on GPU) ---
WHISPER_MODEL=base.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

# --- Wake word ---
WAKE_THRESHOLD=0.5
# Comma-separated OpenWakeWord model names. "hey_jarvis" is the MVP stand-in until
# a custom "Hey KOBE" model is trained.
WAKE_MODELS=hey_jarvis

# --- Audio ---
# Integer device index from `python -m sounddevice`. Leave blank for defaults.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000

# --- Recording limits ---
VAD_AGGRESSIVENESS=2
MAX_RECORD_SECONDS=15
SILENCE_END_MS=800

# --- Mute ---
MUTE_HOTKEY=ctrl+alt+k

# --- HUD (Phase 2) ---
HUD_HOST=127.0.0.1
HUD_PORT=8765
HUD_ENABLED=true
SYSTEM_STATUS_INTERVAL_S=2.0

# --- Bambu Lab P1S (Phase 3) ---
# LAN access: find the IP in the printer's network settings, the serial on the
# label under the bed, and the access code in Device > General > LAN Access.
BAMBU_HOST=
BAMBU_SERIAL=
BAMBU_ACCESS_CODE=
BAMBU_POLL_INTERVAL_S=5.0
BAMBU_ENABLED=true

# --- Spotify (Phase 3) ---
# Create an app at https://developer.spotify.com/dashboard — add
# http://127.0.0.1:8888/callback to Redirect URIs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_POLL_INTERVAL_S=5.0

# --- Discord alerts (Phase 3) ---
DISCORD_WEBHOOK_URL=

# --- Confirmation flow (Phase 3) ---
CONFIRMATION_TIMEOUT_S=12.0
CONFIRMATION_YES_WORDS=yes,yeah,yep,confirm,confirmed,do it,go ahead,sure
CONFIRMATION_NO_WORDS=no,nope,cancel,stop,nevermind,never mind,abort

# --- Screen vision (Phase 4) ---
# "null" = capture only, no model call. Real options: openclaw | openai.
VISION_ENABLED=true
VISION_BACKEND=null
VISION_SAVE_SCREENSHOTS=false
VISION_SCREENSHOT_DIR=scratch/vision
VISION_MAX_CAPTURE_SECONDS=5.0
VISION_JPEG_QUALITY=80
VISION_MAX_EDGE_PX=1568
OPENAI_VISION_MODEL=gpt-4o-mini
OPENCLAW_VISION_PATH=/v1/vision
OPENCLAW_VISION_TIMEOUT_S=30.0

# --- Logging ---
LOG_LEVEL=INFO
